# Managed by Ansible — do not edit manually

[DEFAULT]
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
backend  = systemd
destemail = root@localhost
sendername = Fail2Ban
action = %(action_)s

# ── SSH Protection ────────────────────────────
[sshd]
enabled  = true
port     = {{ ssh_port }}
filter   = sshd
logpath  = %(sshd_log)s
maxretry = {{ fail2ban_maxretry }}
bantime  = {{ fail2ban_bantime }}

# ── Repeat offender — longer ban ──────────────
[sshd-ddos]
enabled  = true
port     = {{ ssh_port }}
filter   = sshd
logpath  = %(sshd_log)s
maxretry = 2
bantime  = 86400

