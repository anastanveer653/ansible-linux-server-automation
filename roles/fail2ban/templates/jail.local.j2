{{ ansible_managed | comment }}

[DEFAULT]
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
{% if fail2ban_bantime_increment | bool %}
bantime.increment = true
bantime.maxtime   = {{ fail2ban_bantime_maxtime }}
{% endif %}
ignoreip = {{ fail2ban_ignoreip | join(' ') }}
backend  = systemd
banaction          = {{ fail2ban_banaction }}
banaction_allports = {{ fail2ban_banaction_allports }}

[sshd]
enabled = true
mode    = aggressive
port    = {{ fail2ban_ssh_port }}
{% if fail2ban_recidive | bool %}

[recidive]
enabled   = true
backend   = auto
logpath   = /var/log/fail2ban.log
banaction = %(banaction_allports)s
bantime   = 1w
findtime  = 1d
maxretry  = 3
{% endif %}
{% for jail, options in fail2ban_extra_jails | dictsort %}

[{{ jail }}]
{%   for key, value in options | dictsort %}
{{ key }} = {{ value | lower if value is boolean else value }}
{%   endfor %}
{% endfor %}
